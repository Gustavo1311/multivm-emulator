<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- rede da VM (NAT) e servidor VNC -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- microfone da VM (pedido so quando a VM usa) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- opcao "Continuar rodando a VM em segundo plano": servico com notificacao fixa e CPU acordada -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".MultiVmApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/Theme.MultiVM">

        <!-- tela inicial: lista de VMs -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- edicao de uma VM -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- configuracoes gerais: tema, tela, mouse, discos -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- boas-vindas e criacao da primeira VM -->
        <activity
            android:name=".WizardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- a VM sobrevive a rotacao: a activity nao e recriada -->
        <activity
            android:name=".VmActivity"
            android:theme="@style/Theme.MultiVM.Vm"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- mantem a VM rodando fora da tela (notificacao fixa com Abrir/Pausar/Parar) -->
        <service
            android:name=".VmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Emulador de computador: a maquina virtual continua executando quando o usuario sai do app" />
        </service>
    </application>
</manifest>
