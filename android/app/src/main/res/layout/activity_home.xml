<?xml version="1.0" encoding="utf-8"?>
<!-- Tela inicial: as VMs em pilulas (menu de tres pontos em cada) e o botao de nova VM. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:text="MULTIVM"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Máquinas virtuais"
                android:textColor="@color/text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeCount"
                style="@style/WizHelp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/vmList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- sem VMs -->
            <LinearLayout
                android:id="@+id/homeEmpty"
                style="@style/Card"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="MultiVM"
                    android:src="@drawable/ic_launcher" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Nenhuma máquina virtual"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/WizHelp"
                    android:gravity="center"
                    android:text="Toque em “Nova máquina virtual” para criar uma com o assistente." />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        android:padding="12dp">

        <Button
            android:id="@+id/homeNew"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:drawableStart="@drawable/ic_add"
            android:text="Nova máquina virtual" />
    </LinearLayout>
</LinearLayout>
