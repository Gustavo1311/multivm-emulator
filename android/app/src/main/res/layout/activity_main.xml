<?xml version="1.0" encoding="utf-8"?>
<!-- Tela principal: cabecalho com a VM, cartoes por categoria e o botao Iniciar fixo embaixo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- cabecalho: voltar para a lista e o nome da VM (editavel) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="-8dp"
                    android:background="@drawable/round_btn_bg"
                    android:contentDescription="Voltar"
                    android:src="@drawable/ic_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:letterSpacing="0.15"
                    android:text="EDITAR VM"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nome da VM"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/chipArch" style="@style/Chip" />
                    <TextView android:id="@+id/chipRam" style="@style/Chip" />
                    <TextView android:id="@+id/chipMode" style="@style/Chip" />
                    <TextView android:id="@+id/chipMedia" style="@style/Chip" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Sistema -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:drawableStart="@drawable/ic_monitor"
                    android:text="Sistema" />

                <TextView
                    style="@style/Label"
                    android:text="Arquitetura" />

                <Spinner
                    android:id="@+id/arch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/Label"
                    android:text="Modo de boot" />

                <RadioGroup
                    android:id="@+id/bootMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/modeBios"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="PC com BIOS" />

                    <RadioButton
                        android:id="@+id/modeKernel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Kernel Linux" />
                </RadioGroup>
            </LinearLayout>

            <!-- Hardware -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:drawableStart="@drawable/ic_memory"
                    android:text="Hardware" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Memória"
                        android:textColor="@color/text2" />

                    <EditText
                        android:id="@+id/ram"
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:inputType="number"
                        android:text="512" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" MiB"
                        android:textColor="@color/text2" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/ramBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Armazenamento -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:drawableStart="@drawable/ic_hdd"
                    android:text="Armazenamento" />

                <com.multivm.app.MediaListView
                    android:id="@+id/mlDisks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.multivm.app.MediaListView
                    android:id="@+id/mlCds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.multivm.app.MediaListView
                    android:id="@+id/mlFloppies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/ctrlGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Label"
                        android:layout_marginTop="16dp"
                        android:text="Controlador" />

                    <RadioGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/ide"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="IDE" />

                        <RadioButton
                            android:id="@+id/sata"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="SATA/AHCI" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/ctrlHelp"
                        style="@style/WizHelp"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Inicializacao -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:drawableStart="@drawable/ic_boot"
                    android:text="Inicialização" />

                <!-- boot por BIOS -->
                <LinearLayout
                    android:id="@+id/biosGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Label"
                        android:text="Ordem de boot" />

                    <Spinner
                        android:id="@+id/bootOrder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- boot direto de kernel -->
                <LinearLayout
                    android:id="@+id/kernelGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Label"
                        android:text="Kernel" />

                    <LinearLayout style="@style/FileRow">
                        <TextView android:id="@+id/kernelName" style="@style/FileName" />
                        <Button android:id="@+id/kernelPick" style="@style/SmallButton" android:text="Escolher" />
                        <Button android:id="@+id/kernelClear" style="@style/SmallButton" android:text="✕" />
                    </LinearLayout>

                    <TextView
                        style="@style/Label"
                        android:text="Initrd (opcional)" />

                    <LinearLayout style="@style/FileRow">
                        <TextView android:id="@+id/initrdName" style="@style/FileName" />
                        <Button android:id="@+id/initrdPick" style="@style/SmallButton" android:text="Escolher" />
                        <Button android:id="@+id/initrdClear" style="@style/SmallButton" android:text="✕" />
                    </LinearLayout>

                    <TextView
                        style="@style/Label"
                        android:text="Linha de comando (vazio = console padrão)" />

                    <EditText
                        android:id="@+id/cmdline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:hint="console=ttyS0"
                        android:inputType="text" />

                    <CheckBox
                        android:id="@+id/fbEnable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tela gráfica (framebuffer)" />

                    <EditText
                        android:id="@+id/fbSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="LARGURAxALTURA"
                        android:inputType="text"
                        android:text="800x600" />
                </LinearLayout>
            </LinearLayout>

            <!-- Som e rede -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:drawableStart="@drawable/ic_network"
                    android:text="Som e rede" />

                <TextView
                    style="@style/Label"
                    android:text="Placa de som" />

                <Spinner
                    android:id="@+id/sound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <CheckBox
                    android:id="@+id/mic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Microfone (entrada de áudio do aparelho)" />

                <TextView
                    style="@style/Label"
                    android:text="Placa de rede" />

                <Spinner
                    android:id="@+id/nic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/netHelp"
                    style="@style/WizHelp"
                    android:textSize="12sp" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="16dp"
                    android:text="Redirecionamento de portas (aparelho → VM)" />

                <LinearLayout
                    android:id="@+id/fwdList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/fwdAdd"
                    style="@style/OutlineButton"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_add"
                    android:drawableTint="@color/accent"
                    android:text="Adicionar redirecionamento" />
            </LinearLayout>

            <!-- Acesso remoto -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:drawableStart="@drawable/ic_cast"
                    android:text="Acesso remoto (VNC)" />

                <CheckBox
                    android:id="@+id/vnc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Ativar servidor VNC" />

                <LinearLayout
                    android:id="@+id/vncGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Label"
                        android:text="Tela ou porta (1 = tela :1 = porta 5901)" />

                    <EditText
                        android:id="@+id/vncPort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="5900" />

                    <TextView
                        style="@style/Label"
                        android:text="Senha (opcional, até 8 caracteres)" />

                    <EditText
                        android:id="@+id/vncPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLength="8" />

                    <CheckBox
                        android:id="@+id/vncLan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permitir acesso pela rede local (Wi-Fi)" />

                    <TextView
                        android:id="@+id/vncHelp"
                        style="@style/WizHelp"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/text2"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <!-- barra inferior com o botao principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        android:padding="12dp">

        <Button
            android:id="@+id/start"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:drawableStart="@drawable/ic_play"
            android:text="Iniciar VM" />
    </LinearLayout>
</LinearLayout>
