<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- tema claro: mesmas cores por nome (values-notnight/colors.xml) sobre o Material claro -->
    <style name="Theme.MultiVM" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:colorControlNormal">@color/text2</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:alertDialogTheme">@style/Theme.MultiVM.Dialog</item>
    </style>

    <style name="Theme.MultiVM.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:colorControlActivated">@color/accent</item>
    </style>

    <!-- tela da VM: barras do sistema pretas com icones claros -->
    <style name="Theme.MultiVM.Vm" parent="Theme.MultiVM">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
